# --- Local (Ollama) app ---
# DATABASE_URL points at your local Postgres for the local app.
DATABASE_URL=postgresql://localhost:5432/llm_question_log
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx

# --- Vercel (OpenRouter) deployment ---
# Set these in Vercel's environment variables (Production/Preview), not in .env.
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=openrouter/free

# --- Mr. Kaypoh (Research Agent) ---
# SERPAPI_KEY=your_serpapi_key_here   # for the SEARCH tool (https://serpapi.com)
# USE_FIXTURES=0                      # set 1 to use saved results instead of live SerpApi

# --- Mr. Bounce (Trip Orchestrator) ---
# Also uses SERPAPI_KEY (above) for Google Maps place/directions data.
# PLANNER_SCOUT_MODEL / PLANNER_CRITIC_MODEL / PLANNER_ALTERNATIVES_MODEL / PLANNER_COMPILER_MODEL
#   optional per-agent OpenRouter overrides; default inherits OPENROUTER_MODEL (openrouter/free)
